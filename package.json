{
  "name": "gyroview",
  "version": "0.0.0",
  "private": true,
  "description": "Browser player for raw Insta360 .insv recordings",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise packages apps tools --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm depcruise && pnpm test",
    "spike": "pnpm --filter @gyroview/spike dev",
    "spike:serve-samples": "pnpm --filter @gyroview/spike serve-samples",
    "inspect": "pnpm --filter @gyroview/insv-inspect inspect --"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "@vitest/coverage-v8": "5.0.1",
    "dependency-cruiser": "18.3.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-unicorn": "75.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "type": "module"
}
