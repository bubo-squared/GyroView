{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "ESNext.Array", "DOM", "DOM.Iterable"],
    "stripInternal": true,
    "types": ["vite/client"],
    "paths": {
      "@gyroview/core": ["../../packages/core/src/index.ts"],
      "@gyroview/player": ["../../packages/player/src/index.ts"],
      "@gyroview/adapter-*": ["../../packages/adapters/*/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
