{
  "name": "@gyroview/core",
  "version": "0.0.0",
  "private": true,
  "description": "GyroView domain and application layer: Insta360 .insv format, optics, motion and playback. Pure TypeScript with no runtime dependencies.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json && tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "vitest": "5.0.1"
  }
}
