{
  "name": "@gyroview/integration",
  "version": "0.0.0",
  "private": true,
  "description": "Integration tests that combine several adapters against the real recordings, in Node and in real browsers (not run when the samples are absent).",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "measure": "vitest run --config vitest.measure.config.ts"
  },
  "devDependencies": {
    "@gyroview/adapter-mediabunny": "workspace:*",
    "@gyroview/adapter-mse-audio": "workspace:*",
    "@gyroview/adapter-node": "workspace:*",
    "@gyroview/adapter-three": "workspace:*",
    "@gyroview/core": "workspace:*",
    "@types/node": "26.6.1",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "mediabunny": "^1.65.2",
    "playwright": "1.63.0",
    "vite": "8.3.3",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@gyroview/player": "workspace:*"
  }
}
